# svpchain-perps-agent configuration.
#
# Short, because the agent is: it serves an A2A surface whose every operation
# is one call to an MCP server. The chain endpoints, fee, cache and limits this
# file used to carry configured a copy of that server running in-process, and
# are the server's settings now. Unknown keys are ignored, so a config still
# carrying them loads fine.

listen_addr = ":8082"
# How callers reach this agent; advertised verbatim in the Agent Card.
public_url  = "http://localhost:8082"

# The MCP server implementing this agent's operations (svpchain-dex-mcp).
# Required. It serves MCP at the root of its listener, so this is an origin and
# not a path.
[mcp]
endpoint = "https://dex-mcp-testnet.svpchain.org/"
# call_timeout = "30s"

# The model-driven skill, served only when a key is in the environment.
#
# provider picks the API format: "anthropic" (default) for the native Messages
# API, or "openai" for the chat-completions format that OpenAI, DeepSeek and
# most local runtimes serve. The key follows: ANTHROPIC_API_KEY or
# OPENAI_API_KEY. base_url points a provider at a particular vendor.
#
# ★ Only the anthropic provider caches the tool catalog. The chat-completions
# format has no cache breakpoint, so on that path the tool schemas are re-billed
# on every turn of every planning loop.
[assistant]
# provider       = "anthropic"
# base_url       = ""
# model          = "claude-opus-5"
# max_iterations = 8
# max_tool_calls = 24
# timeout        = "90s"
